    "@supabase/supabase-js": "^2.112.3",
    "iso-639-1": "^3.1.6",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "rate-limiter-flexible": "^11.2.1",
    "resend": "^6.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.126",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
