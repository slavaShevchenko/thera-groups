generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  VISITOR
  ORGANIZER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum GroupFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum GroupType {
  THERAPEUTIC
  WORKSHOP
  SEMINAR
  LECTURE
  LECTURE_COURSE
  INTENSIVE
  AUTHOR_PROGRAM
  SUPERVISION
  INTERVISION
  CONFERENCE
  SYMPOSIUM
  CERTIFICATION
  SPECIALIZATION
  EDUCATIONAL_PROGRAMS
  MODULAR
  PILOT
  OTHER
}

enum GroupStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  FULL
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum QuestionType {
  TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_WITHDRAWN
  GROUP_APPROVED
  GROUP_REJECTED
  GROUP_STARTING
  GROUP_PENDING_REVIEW
  GROUP_SUBMITTED
  GROUP_AUTO_REVERT
  GROUP_COMPLETED
  GROUP_CANCELLED
  ORGANIZER_PENDING_REVIEW
  ORGANIZER_APPROVED
  ORGANIZER_REJECTED
  ORGANIZER_WELCOME
}

// Reserved for future functionality — currently unused. Nothing in server/ or app/ reads or
// writes the `Review` model this belongs to; see docs/database.md#deprecated-tables.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Reserved for future functionality — currently unused, like `ReviewStatus` above.
enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum EmailEventStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
  SKIPPED
  DEV_PREVIEW
  DELIVERED
  COMPLAINED
}

// ==========================================
// MODELS
// ==========================================

// CHECK: "preferredLocale" IN ('ua', 'en')
model User {
  id               String    @id @default(cuid())
  authId           String?   @unique
  email            String    @unique
  role             Role      @default(VISITOR)
  isActive         Boolean   @default(true)
  preferredLocale  String    @default("ua")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organizerProfile OrganizerProfile?
  notifications    Notification[]
  favorites        Favorite[]
  reviews          Review[]
  reports          Report[] @relation("ReportReporter")
  coOrganizedGroups GroupCoOrganizer[]
  applications     Application[]

  @@index([role])
}

model OrganizerProfile {
  id                             String             @id @default(cuid())
  userId                         String             @unique
  slug                           String             @unique
  firstName                      String
  lastName                       String
  avatarUrl                      String?
  bio                            String?
  qualification                  String?
  specializations                String[]           @default([])
  experienceYears                Int?
  languages                      String[]           @default([])
  workFormats                    String[]           @default([])
  city                           String?
  education                      String[]           @default([])
  professionalOrganization       String             @default("")
  professionalOrganizationStatus String             @default("")
  telegramUrl                    String?
  instagramUrl                   String?
  linkedinUrl                    String?
  whatsappUrl                    String?
  facebookUrl                    String?
  youtubeUrl                     String?
  location                       String?
  website                        String?
  verificationStatus             VerificationStatus @default(UNVERIFIED)
  rejectionReason                String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups  Group[]
  reviews Review[]

  @@index([verificationStatus])
}

model GroupTag {
  id     String   @id @default(cuid())
  name   String   @unique
  slug   String   @unique
  groups Group[]
}

// CHECK: "priceAmount" IS NULL OR "priceAmount" >= 0
// CHECK: "endsAt" IS NULL OR "startsAt" IS NULL OR "endsAt" > "startsAt"
// CHECK: capacity IS NULL OR capacity > 0
// CHECK: "minParticipants" IS NULL OR "minParticipants" > 0
// CHECK: "durationHours" IS NULL OR "durationHours" > 0
model Group {
  id          String        @id @default(cuid())
  organizerId String?
  title       String
  slug        String        @unique
  description String
  program     String?
  format      GroupFormat?
  type        GroupType?
  location    String?
  // ISO 639-1 codes the event is *conducted* in, plural on purpose: a bilingual group
  // (uk + ru) and one running with a translator are both normal. Same column shape as
  // `OrganizerProfile.languages`, so a filter can compare the two directly.
  //
  // Deliberately unindexed. The catalog filter uses `hasSome`, which compiles to the array
  // overlap operator `&&`, and `@@index([languages])` makes Prisma emit a plain B-tree index
  // (`CREATE INDEX … ON "Group"("languages")`) that cannot serve it — the query would keep
  // seq-scanning while looking indexed. Serving `&&` needs a hand-written
  // `USING GIN ("languages")`, which is worth adding when this table is large enough to
  // notice, not at three rows.
  languages   String[]      @default([])
  startsAt    DateTime?
  endsAt      DateTime?
  timezone    String        @default("UTC")
  capacity    Int?
  minParticipants Int?
  durationHours   Int?
  certificateIssued Boolean?
  priceAmount Decimal? @db.Decimal(10, 2)
  currency    String        @default("UAH")
  status           GroupStatus   @default(DRAFT)
  rejectionReason  String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizer    OrganizerProfile?   @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  coOrganizers GroupCoOrganizer[]
  tags         GroupTag[]
  applications Application[]
  questions    ApplicationQuestion[]
  favorites    Favorite[]
  reviews      Review[]

  @@index([organizerId])
  @@index([type])
  @@index([status, type])
  @@index([startsAt])
  @@index([createdAt])
}

model GroupCoOrganizer {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Application {
  id              String            @id @default(cuid())
  groupId         String
  userId          String?
  name            String
  email           String
  phone           String?
  message         String?
  status          ApplicationStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  group   Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers ApplicationAnswer[]

  @@index([groupId])
  @@index([status])
  @@index([email])
  @@index([userId])
  @@unique([groupId, email])
}

model ApplicationQuestion {
  id         String       @id @default(cuid())
  groupId    String
  question   String
  type       QuestionType @default(TEXT)
  required   Boolean      @default(false)
  position   Int
  options    String[]     @default([])
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  answers    ApplicationAnswer[]

  @@index([groupId])
}

model ApplicationAnswer {
  id            String   @id @default(cuid())
  applicationId String
  questionId    String
  value         String

  application Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  entityType String
  entityId   String
  title      String
  message    String
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([readAt])
  @@index([userId, readAt])
}

model Favorite {
  userId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

// Reserved for future functionality — currently unused.
//
// Empty in production and referenced by no query, service or page. Kept rather than dropped
// because the relations below are real: three `ON DELETE CASCADE` foreign keys and a
// `@@unique([userId, groupId])` that a review feature would need, and removing them means a
// hand-written migration to recreate them later. Carrying an empty table is cheaper than
// that round trip. What it does cost is a reader's time, hence this comment and
// docs/database.md#deprecated-tables.
//
// Do not wire it up without deciding moderation first: a public rating on a therapist is
// content the platform becomes responsible for.
// CHECK: rating BETWEEN 1 AND 5
model Review {
  id          String        @id @default(cuid())
  organizerId String
  userId      String
  groupId     String
  rating      Int
  comment     String
  status      ReviewStatus  @default(PENDING)
  createdAt   DateTime      @default(now())

  organizer OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([groupId])
  @@unique([userId, groupId])
}

// Reserved for future functionality — currently unused, for the same reasons as `Review`
// above. Note `entityType`/`entityId` are a polymorphic pair with no foreign key behind
// them, so a report outlives whatever it was filed against and nothing enforces that the
// type names a real table. See docs/database.md#deprecated-tables.
model Report {
  id          String       @id @default(cuid())
  reporterId  String
  entityType  String
  entityId    String
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([entityType, entityId])
}

// CHECK: "locale" IS NULL OR "locale" IN ('ua', 'en')
// `html` is written for DEV_PREVIEW rows only; production rows leave it NULL.
model EmailEvent {
  id         String           @id @default(cuid())
  type       String
  template   String?
  recipient  String
  entityId   String?
  providerId String?
  locale     String?
  html       String?
  status     EmailEventStatus @default(PENDING)
  sentAt     DateTime?
  error      String?
  createdAt  DateTime         @default(now())

  @@index([recipient])
  @@index([status])
  @@index([providerId])
}
