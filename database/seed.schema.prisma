generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  VISITOR
  ORGANIZER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum GroupFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum GroupStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  FULL
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum QuestionType {
  TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  GROUP_APPROVED
  GROUP_REJECTED
  GROUP_STARTING
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum EmailEventStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  role             Role     @default(VISITOR)
  preferredLocale  String   @default("ua")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organizerProfile OrganizerProfile?
  notifications    Notification[]
  favorites        Favorite[]
  reviews          Review[]
  reports          Report[] @relation("ReportReporter")

  @@index([email])
}

model OrganizerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  firstName          String
  lastName           String
  avatar             String?
  bio                String?
  qualification      String?
  specializations    String[]           @default([])
  experienceYears    Int?
  languages          String[]
  location           String?
  website            String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups  Group[]
  reviews Review[]

  @@index([userId])
}

model GroupCategory {
  id       String   @id @default(cuid())
  name     String   @unique
  slug     String   @unique
  groups   Group[]

  @@index([slug])
}

model GroupTag {
  id     String   @id @default(cuid())
  name   String   @unique
  slug   String   @unique
  groups Group[]

  @@index([slug])
}

model Group {
  id          String        @id @default(cuid())
  organizerId String
  title       String
  slug        String        @unique
  description String
  categoryId  String
  format      GroupFormat
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  timezone    String        @default("UTC")
  capacity    Int
  price       Float
  currency    String        @default("RUB")
  status      GroupStatus   @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizer    OrganizerProfile    @relation(fields: [organizerId], references: [id])
  category     GroupCategory       @relation(fields: [categoryId], references: [id])
  tags         GroupTag[]
  applications Application[]
  questions    ApplicationQuestion[]
  favorites    Favorite[]
  reviews      Review[]

  @@index([organizerId])
  @@index([status])
  @@index([slug])
  @@index([categoryId])
}

model Application {
  id        String            @id @default(cuid())
  groupId   String
  name      String
  email     String
  phone     String?
  message   String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  group   Group              @relation(fields: [groupId], references: [id])
  answers ApplicationAnswer[]

  @@index([groupId])
  @@index([status])
  @@index([email])
}

model ApplicationQuestion {
  id         String       @id @default(cuid())
  groupId    String
  question   String
  type       QuestionType @default(TEXT)
  required   Boolean      @default(false)
  position   Int
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  answers    ApplicationAnswer[]

  @@index([groupId])
}

model ApplicationAnswer {
  id            String   @id @default(cuid())
  applicationId String
  questionId    String
  value         String

  application Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([applicationId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  entityType String
  entityId   String
  title      String
  message    String
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model Favorite {
  userId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Review {
  id          String   @id @default(cuid())
  organizerId String
  userId      String
  groupId     String
  rating      Int
  comment     String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  organizer OrganizerProfile @relation(fields: [organizerId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  group     Group            @relation(fields: [groupId], references: [id])

  @@index([organizerId])
  @@index([groupId])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  entityType  String
  entityId    String
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([entityType, entityId])
}

model EmailEvent {
  id         String           @id @default(cuid())
  type       String
  recipient  String
  entityId   String?
  providerId String?
  status     EmailEventStatus @default(PENDING)
  sentAt     DateTime?
  error      String?
  createdAt  DateTime         @default(now())

  @@index([recipient])
  @@index([status])
}