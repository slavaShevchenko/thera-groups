# Database
DATABASE_URL=postgresql://...

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: Supabase Storage bucket holding organizer avatars. The bucket itself is NOT
# created by any migration — buckets live in the `storage` schema, outside what Prisma
# manages — so it has to be created by hand in each project, public, with a SELECT policy
# for the `public` role. Without both, every avatar upload answers 500. Step-by-step:
# docs/deployment.md#storage-buckets
# STORAGE_BUCKET_ORGANIZER_AVATARS=organizer-avatars

# Email (Resend) — optional in dev, REQUIRED in production: configValidation refuses to
# boot a production deployment without all three, because a catalog that cannot mail is a
# catalog that silently never tells anyone their application arrived.
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@psygroup.org

# Optional: set to true to actually deliver mail from `nuxt dev`. Without it the email
# service short-circuits in dev and stores the rendered HTML on the EmailEvent row
# (status DEV_PREVIEW) instead of calling Resend.
# EMAIL_FORCE_SEND=true

# Signing secret for the Resend delivery webhook (POST /api/webhooks/resend), copied from
# Resend → Webhooks. Format `whsec_...`. Required in production. Without it the endpoint
# rejects every request with 401 there, and accepts unverified requests in dev (with a
# warning), so delivery statuses simply stay at SENT.
# RESEND_WEBHOOK_SECRET=whsec_...

# Site
SITE_URL=http://localhost:3000

# Optional: Strict-Transport-Security. The header cannot be revoked, so it defaults to
# max-age=300 (five minutes) and is raised in steps once every subdomain has valid TLS —
# see docs/deployment.md#hsts-rollout.
# HSTS_MAX_AGE=300
# HSTS_INCLUDE_SUBDOMAINS=true

# Optional: how many trusted proxy hops sit to the RIGHT of the real client address in
# x-forwarded-for, used by getClientIP() for rate limiting. Unset walks the header right
# to left and skips reserved/infrastructure addresses; 0 takes the right-most entry, which
# is what Vercel appends and the recommended explicit setting for it. N > 0 is for a
# deployment behind its own nginx or load balancer. See docs/security.md.
# x-real-ip is never read: a client can set it, so it cannot identify anyone.
# TRUSTED_PROXY_HOPS=0

# Optional: first-admin bootstrap + dev seed (npm run db:seed).
# used ONLY when the database has zero admins; ignored otherwise
ADMIN_EMAIL=admin@psygroup.local
# ADMIN_PASSWORD=<generate with: openssl rand -base64 32>

# Optional: separate database URL for integration tests.
# If unset, the integration suites are skipped with a warning — they never fall back
# to DATABASE_URL. Must be a throwaway database: tests/integration/_guard.ts refuses
# to run when TEST_DATABASE_URL equals DATABASE_URL.
# TEST_DATABASE_URL=postgresql://...

# Optional: e2e (Playwright) settings
# E2E_BASE_URL=http://localhost:3000
# E2E_PORT=3000
# The group-editor specs stay skipped until all three are set. Point E2E_GROUP_SLUG at
# a draft group owned by that organizer; PATCH/POST/DELETE calls are stubbed in-browser.
# E2E_ORGANIZER_EMAIL=organizer@example.com
# E2E_ORGANIZER_PASSWORD=...
# E2E_GROUP_SLUG=my-draft-group
# E2E_COORGANIZER_QUERY=а
