# Database
DATABASE_URL=postgresql://...

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@psygroup.org

# Optional: set to true to actually deliver mail from `nuxt dev`. Without it the email
# service short-circuits in dev and stores the rendered HTML on the EmailEvent row
# (status DEV_PREVIEW) instead of calling Resend.
# EMAIL_FORCE_SEND=true

# Optional: signing secret for the Resend delivery webhook (POST /api/webhooks/resend),
# copied from Resend → Webhooks. Format `whsec_...`. Without it the endpoint rejects
# every request with 401 in production and accepts unverified requests in dev (with a
# warning), so delivery statuses simply stay at SENT.
# RESEND_WEBHOOK_SECRET=whsec_...

# Site
SITE_URL=http://localhost:3000

# Admin seed (used by npm run db:seed)
# ADMIN_PASSWORD=<generate with: openssl rand -base64 32>
ADMIN_EMAIL=admin@psygroup.local

# Optional: separate database URL for integration tests.
# If unset, the integration suites are skipped with a warning — they never fall back
# to DATABASE_URL. Must be a throwaway database: tests/integration/_guard.ts refuses
# to run when TEST_DATABASE_URL equals DATABASE_URL.
# TEST_DATABASE_URL=postgresql://...

# Optional: e2e (Playwright) settings
# E2E_BASE_URL=http://localhost:3000
# E2E_PORT=3000
# The group-editor specs stay skipped until all three are set. Point E2E_GROUP_SLUG at
# a draft group owned by that organizer; PATCH/POST/DELETE calls are stubbed in-browser.
# E2E_ORGANIZER_EMAIL=organizer@example.com
# E2E_ORGANIZER_PASSWORD=...
# E2E_GROUP_SLUG=my-draft-group
# E2E_COORGANIZER_QUERY=а
